---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, press } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
}
const { title, description, ogType = 'website', ogImage } = Astro.props;
const fullTitle = title === profile.name ? profile.name : `${title} | ${profile.name}`;
// Only emit absolute URLs when a real deployment origin is configured.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// Pages without their own image share the branded preview card.
const ogPath = ogImage ?? url('/images/og-card.png');
const ogAlt = ogImage ? description : `${profile.name}: ${profile.headline}`;
const ogImageUrl = Astro.site ? new URL(ogPath, Astro.site).href : null;
// Keep previews out of search engines until Reyna chooses to be indexed.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
// Structured data that tells search engines which profiles belong to Reyna.
// Only on the homepage, and only when a real site address is configured.
const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : null;
const personLd = isHome && homeUrl ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${homeUrl}#person`,
  name: profile.name,
  alternateName: ['Reyna Gowie', 'Reyna Simone', 'Reyna S. Gowie'],
  url: homeUrl,
  image: profile.headshot ? new URL(url(profile.headshot.src), Astro.site).href : undefined,
  description: profile.shortBio,
  jobTitle: 'AI Engineer Co-Op',
  worksFor: { '@type': 'Organization', name: 'IBM', url: 'https://www.ibm.com' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Penn State University', url: 'https://www.psu.edu' },
  memberOf: [
    { '@type': 'Organization', name: 'Students Teaching Students', url: 'https://www.stspsu.org/about' },
    { '@type': 'Organization', name: 'Penn State Student Advisory Committee on AI', url: 'https://ai.psu.edu/about/committees-councils/student-advisory-committee-on-ai' },
  ],
  knowsAbout: ['Human-centered AI', 'AI governance', 'Future of work', 'Decision Architecture'],
  subjectOf: press.map((p) => ({ '@type': 'NewsArticle', headline: p.title, url: p.url, publisher: { '@type': 'Organization', name: p.outlet } })),
  sameAs: [
    profile.linkedin,
    'https://reynasimone.substack.com',
    'https://www.instagram.com/reynasimoneofficial/',
    profile.github,
    'https://reynasimone.gumroad.com',
    'https://linktr.ee/reynasimone',
  ],
} : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <!-- Google Search Console ownership verification -->
    <meta name="google-site-verification" content="OWjX48vji-k4BQURiG6GRxQoCNueg9IctYqgi0DcPF8" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && !ogImage && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && !ogImage && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={ogAlt} />}
    {personLd && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&display=swap" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
