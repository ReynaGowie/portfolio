---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ImageCredit from '../components/ImageCredit.astro';
import { url, readingMinutes } from '../lib/url';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;
const mins = readingMinutes(post.body);
const dateText = d.pubDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={d.title} description={d.description} ogType="article" ogImage={url(d.image.src)}>
  <article class="narrow" data-article data-status={d.status}>
    <p class="back"><a href={url('/blog/')}>← Back to the blog</a></p>
    {import.meta.env.DEV && d.status !== 'final' && (
      <p class="dev-note"><strong>Dev preview only:</strong> status is “{d.status}”. {d.status === 'outline' ? 'This post is hidden from production builds until Reyna writes it.' : 'Not yet approved as final.'}{d.image.placeholder ? ' Image is a placeholder.' : ''}</p>
    )}
    <p class="eyebrow">{d.topic}</p>
    <h1>{d.title}</h1>
    <p class="byline">By {d.author}{dateText && <> · <time datetime={d.pubDate!.toISOString()}>{dateText}</time></>} · {mins} min read</p>
    <ImageCredit {...d.image} />
    <div class="prose" data-article-body>
      <slot />
    </div>
    <p class="back end"><a href={url('/blog/')}>← Back to the blog</a></p>
  </article>
</BaseLayout>
<style>
  h1 { font-size: var(--step-4); }
  .byline { color: var(--muted); font-size: var(--step--1); }
  .back { font-size: var(--step--1); }
  .end { margin-top: var(--space-4); padding-top: var(--space-2); border-top: 1px solid var(--border); }
</style>
