---
import BaseLayout from '../layouts/BaseLayout.astro';
import Headshot from '../components/Headshot.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { profile, guessWho, press } from '../data/profile';
import { stateOfState } from '../data/speaking';
import { getPosts } from '../lib/posts';
import { url } from '../lib/url';
const posts = await getPosts();
const talkStatus = stateOfState.delivered ? stateOfState.date : `Scheduled · ${stateOfState.date}`;
---
<BaseLayout title={profile.name} description={`${profile.name}: ${profile.shortBio} Writing on AI, education, and who gets a say in the systems that shape people's lives.`}>
  <section class="wrap"><div class="hero-panel hero">
    <ul class="floaters" aria-hidden="true">
      <li class="chip" style="--tilt:-6deg;top:8%;left:52%">AI engineering</li>
      <li class="chip" style="--tilt:4deg;top:91%;left:22%">course design</li>
      <li class="chip" style="--tilt:-3deg;top:89%;left:52%">youth policy</li>
      <li class="chip" style="--tilt:5deg;top:6%;left:4%">who gets a say?</li>
    </ul>
    <div class="hero-text">
      <h1>
        <span class="sr-only">{profile.headline}</span>
        <span aria-hidden="true">I <span class="cycle script" data-cycle="build,design,test,question,study">build</span> AI<br />and ask who it’s built for.</span>
      </h1>
      <p class="lede">I’m Reyna Gowie, an Enterprise Technology Integration student at Penn State and an AI Engineer Co-Op at IBM.</p>
      <p class="lede">My work connects technology, education, and a question I keep coming back to: who gets a say in the systems that shape their lives?</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/projects/')}>View my work</a>
        <a class="btn btn-secondary" href={url('/blog/')}>Read my writing <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-photo tilt" style="--tilt:3deg"><Headshot /></div>
  </div></section>

  <section class="wrap section" aria-labelledby="work-h">
    <div class="section-head">
      <h2 id="work-h">Selected work</h2>
      <a href={url('/projects/')}>All projects</a>
    </div>
    <div class="panel work">
      <article class="card card-link lead">
        <p class="meta">Course design <span class="status">Launching {guessWho.term}</span></p>
        <h3><a class="stretch" href={url('/projects/#guess-who')}><em>{guessWho.title}</em></a></h3>
        <p class="muted">A philosophy seminar I designed as an undergraduate, with privacy and consent built into how students represent each other.</p>
        <p class="press">Covered by <a href={press[0]!.url} rel="noopener">{press[0]!.outlet}</a>, {press[0]!.date}</p>
        <img src={url('/images/guess-who-structure.svg')} alt="" width="1200" height="675" loading="lazy" />
      </article>
      <div class="side">
        <article class="card card-link">
          <p class="meta">Software and research</p>
          <h3><a class="stretch" href={url('/projects/#technical')}>Software and data projects</a></h3>
          <p class="muted">A network traffic monitor, a finance analytics dashboard, a front-end web prototype, and research on capacity and productivity across 337,000+ observations.</p>
        </article>
        <article class="card card-link">
          <p class="meta">Student leadership <span class="status">Current</span></p>
          <h3><a class="stretch" href={url('/projects/#sts')}>Students Teaching Students</a></h3>
          <p class="muted">As president, I help Penn State undergraduates turn their ideas into real, for-credit courses with faculty supervision.</p>
        </article>
        <article class="card card-link talk">
          <div class="talk-text">
            <p class="meta">Speaking <span class="status">{talkStatus}</span></p>
            <h3><a class="stretch" href={url('/speaking/')}>{stateOfState.title}</a></h3>
            <p class="muted">My State of State 2026 talk on what a degree should demonstrate when AI can do the work.</p>
          </div>
          <div class="tilt talk-photo" style="--tilt:-3deg"><img src={url(stateOfState.photo.src)} alt={stateOfState.photo.alt} width="1200" height="800" loading="lazy" /></div>
        </article>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <a href={url('/blog/')}>All posts</a>
    </div>
    <div class="panel">
      {posts.map((post) => <ArticleRow post={post} showImage />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="contact-h">
    <div class="card cta">
      <h2 id="contact-h">Let’s talk</h2>
      <p class="muted">I’m open to conversations about AI engineering, technology strategy, education, and speaking.</p>
      <div class="actions">
        <a class="btn btn-primary" href={profile.linkedin} rel="noopener">Connect on LinkedIn</a>
        <a class="btn btn-secondary" href={url('/contact/')}>Contact page</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cycle the handwritten verb in the headline.
  const word = document.querySelector<HTMLElement>('.cycle');
  if (word && !reduce) document.fonts.ready.then(() => {
    const words = (word.dataset.cycle || '').split(',');
    let i = 0;
    window.setInterval(() => {
      word.classList.add('out');
      window.setTimeout(() => {
        i = (i + 1) % words.length;
        word.textContent = words[i]!;
        word.classList.remove('out');
      }, 260);
    }, 2400);
  });

  // A trail of small sparkles follows the mouse across the hero.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && !reduce) {
    let lastX = 0, lastY = 0;
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < 45) return;
      lastX = e.clientX; lastY = e.clientY;
      const r = hero.getBoundingClientRect();
      const m = document.createElement('span');
      m.className = 'mark';
      m.setAttribute('aria-hidden', 'true');
      // Four-point sparkle drawn as an inline SVG so it looks the same on every device.
      const size = 10 + Math.round(Math.random() * 10);
      m.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.9 6.6 5.4 11.1 12 12-6.6.9-11.1 5.4-12 12-.9-6.6-5.4-11.1-12-12C6.6 11.1 11.1 6.6 12 0Z" fill="currentColor"/></svg>`;
      if (Math.random() < 0.35) m.classList.add('soft');
      m.style.left = `${e.clientX - r.left}px`;
      m.style.top = `${e.clientY - r.top}px`;
      m.style.setProperty('--r', `${Math.round(Math.random() * 40 - 20)}deg`);
      hero.appendChild(m);
      m.addEventListener('animationend', () => m.remove());
    });
  }
</script>

<style>
  .hero { display: grid; gap: var(--space-4); align-items: center; padding-block: clamp(3rem, 7vw, 5rem); }
  .hero > :not(.floaters) { position: relative; z-index: 1; }
  .floaters { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; display: none; }
  .floaters li { position: absolute; transform: rotate(var(--tilt)); color: var(--accent); font-size: var(--fs-sm); }
  .floaters li:nth-child(odd) { background: var(--accent-soft); border-color: transparent; }
  @media (min-width: 64rem) { .floaters { display: block; } }
  .cycle { display: inline-block; font-size: 1.3em; line-height: 0.8; margin-right: 0.18em; transition: opacity 260ms ease, transform 260ms ease; }
  .cycle.out { opacity: 0; transform: translateY(0.25em) rotate(-3deg); }
  .hero :global(.mark) { position: absolute; z-index: 0; pointer-events: none; color: var(--accent); line-height: 0; animation: drift 1100ms ease-out forwards; }
  .hero :global(.mark.soft) { color: #c88aa9; }
  @keyframes drift { from { opacity: 0.7; transform: translate(-50%, -50%) rotate(var(--r)) scale(0.8); } to { opacity: 0; transform: translate(-50%, -140%) rotate(var(--r)) scale(1.1); } }
  @media (min-width: 52rem) { .hero { grid-template-columns: 1fr 19rem; gap: var(--space-5); } }
  .hero h1 { max-width: none; margin-bottom: var(--space-3); }
  .hero-photo { max-width: 19rem; justify-self: center; }
  .hero-photo :global(.headshot) { border-radius: calc(var(--r) - 5px); max-width: none; }

  .work { display: grid; gap: 0.6rem; }
  .work > * + * { margin-top: 0; }
  @media (min-width: 52rem) { .work { grid-template-columns: 1.4fr 1fr; } }
  .side { display: grid; gap: 0.6rem; align-content: start; }
  .work h3 { font-size: var(--fs-md); margin-bottom: 0.5rem; }
  .work h3 a { color: var(--text); text-decoration: none; }
  .work .card-link:hover h3 a { color: var(--accent); }
  .lead h3 { font-size: var(--fs-lg); }
  .meta { font-size: var(--fs-sm); color: var(--muted); display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .press { font-size: var(--fs-sm); color: var(--muted); position: relative; z-index: 1; }
  .lead img { margin-top: var(--space-2); border-radius: var(--r-sm); border: 1px solid var(--border); }
  .muted { margin-bottom: 0; }
  .talk { display: grid; grid-template-columns: 1fr 7.5rem; gap: var(--space-2); align-items: center; }
  .talk-photo { padding: 4px; }
  .talk-photo img { aspect-ratio: 1; object-fit: cover; object-position: 42% 30%; }

  .cta { text-align: center; padding: var(--space-5) var(--space-3); }
  .cta h2 { font-style: italic; }
  .cta .muted { max-width: 32rem; margin-inline: auto; }
  .cta .actions { justify-content: center; }
</style>
