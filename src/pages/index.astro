---
import BaseLayout from '../layouts/BaseLayout.astro';
import Headshot from '../components/Headshot.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { profile, guessWho, press } from '../data/profile';
import { stateOfState } from '../data/speaking';
import { getPosts } from '../lib/posts';
import { url } from '../lib/url';
const posts = await getPosts();
const talkStatus = stateOfState.delivered ? stateOfState.date : `Scheduled · ${stateOfState.date}`;
---
<BaseLayout title={profile.name} description={`${profile.name}: ${profile.shortBio} Writing on AI, education, and who gets a say in the systems that shape people's lives.`}>
  <section class="wrap hero">
    <div class="hero-text">
      <h1>{profile.headline}</h1>
      <p class="lede">I’m Reyna Gowie, an Enterprise Technology Integration student at Penn State and an AI Engineer Co-Op at IBM.</p>
      <p class="lede">My work connects technology, education, and a question I keep coming back to: who gets a say in the systems that shape their lives?</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/projects/')}>View my work</a>
        <a class="btn btn-secondary" href={url('/blog/')}>Read my writing</a>
      </div>
    </div>
    <div class="hero-photo"><Headshot /></div>
  </section>

  <section class="wrap section" aria-labelledby="work-h">
    <div class="section-head">
      <h2 id="work-h">Selected work</h2>
      <a href={url('/projects/')}>All projects</a>
    </div>
    <div class="work">
      <article class="lead">
        <p class="meta">Course design <span class="status">Launching {guessWho.term}</span></p>
        <h3><a href={url('/projects/#guess-who')}><em>{guessWho.title}</em></a></h3>
        <p class="muted">A philosophy seminar I designed as an undergraduate, with privacy and consent built into how students represent each other.</p>
        <p class="press">Covered by <a href={press[0]!.url} rel="noopener">{press[0]!.outlet}</a>, {press[0]!.date}</p>
        <img src={url('/images/guess-who-structure.svg')} alt="" width="1200" height="675" loading="lazy" />
      </article>
      <div class="side">
        <article>
          <p class="meta">Software and research</p>
          <h3><a href={url('/projects/#technical')}>Python and data projects</a></h3>
          <p class="muted">A network traffic monitor, a finance analytics dashboard, and research on capacity and productivity across 337,000+ observations.</p>
        </article>
        <article>
          <p class="meta">Student leadership <span class="status">Current</span></p>
          <h3><a href={url('/projects/#sts')}>Students Teaching Students</a></h3>
          <p class="muted">As president, I help Penn State undergraduates turn their ideas into real, for-credit courses with faculty supervision.</p>
        </article>
        <article>
          <p class="meta">Speaking <span class="status">{talkStatus}</span></p>
          <h3><a href={url('/speaking/')}>{stateOfState.title}</a></h3>
          <p class="muted">A State of State 2026 talk on what a degree should demonstrate when AI can produce the work that used to prove learning.</p>
          <img class="talk-photo" src={url(stateOfState.photo.src)} alt={stateOfState.photo.alt} width="1200" height="800" loading="lazy" />
        </article>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <a href={url('/blog/')}>All posts</a>
    </div>
    <div class="list">
      {posts.map((post) => <ArticleRow post={post} showImage />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="contact-h">
    <div class="section-head">
      <h2 id="contact-h">Get in touch</h2>
    </div>
    <div class="actions flush">
      <a class="btn btn-primary" href={profile.linkedin} rel="noopener">Connect on LinkedIn</a>
      <a class="btn btn-secondary" href={url('/contact/')}>Contact page</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; gap: var(--space-4); align-items: end; }
  @media (min-width: 52rem) { .hero { grid-template-columns: 1fr 20rem; gap: var(--space-5); } }
  .hero h1 { max-width: 16ch; margin-bottom: var(--space-3); }
  .hero-photo { max-width: 20rem; }

  .work { display: grid; gap: var(--space-4); }
  @media (min-width: 52rem) { .work { grid-template-columns: 1.6fr 1fr; gap: var(--space-5); } }
  .work article { min-width: 0; }
  .work h3 a { color: var(--text); text-decoration: none; }
  .work h3 a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; }
  .meta { font-size: var(--fs-sm); color: var(--muted); display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .lead h3 { font-size: var(--fs-lg); }
  .press { font-size: var(--fs-sm); color: var(--muted); }
  .lead img { margin-top: var(--space-3); border: 1px solid var(--border); border-radius: var(--r); background: #fff; }
  .side { display: grid; gap: 0; align-content: start; }
  .side article { border-top: 1px solid var(--border); padding-block: var(--space-3); }
  .side article:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 51.99rem) { .side article:first-child { border-top: 1px solid var(--border); padding-top: var(--space-3); } }
  .side p:last-child { margin: 0; }
  .talk-photo { margin-top: var(--space-2); border-radius: var(--r); aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  .flush { margin-top: 0; }
</style>
