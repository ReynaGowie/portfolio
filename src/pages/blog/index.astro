---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getPosts } from '../../lib/posts';
import { elsewhere, substack } from '../../data/cv';
const posts = await getPosts();
---
<BaseLayout title="Blog" description="Writing by Reyna Gowie on AI, education, and who gets a say in the systems that shape people's lives.">
  <div class="wrap">
    <div class="hero-panel">
      <p class="eyebrow">Blog</p>
      <h1>Writing</h1>
      <p class="lede">Short essays on AI, education, and who gets a say in the systems that shape our lives.</p>
    </div>
    <div class="panel">
      {posts.map((post) => <ArticleRow post={post} headingLevel="h2" showImage />)}
    </div>

    <section class="elsewhere" aria-labelledby="elsewhere-h">
      <h2 id="elsewhere-h">Writing elsewhere</h2>
      <p class="muted">More essays on LinkedIn and on my Substack, <a href={substack.url} rel="noopener">{substack.name}</a>.</p>
      <div class="panel">
        {elsewhere.map((a) => (
          <div class="card card-link ext">
            <a class="stretch" href={a.url} rel="noopener">{a.title} <span aria-hidden="true">↗</span></a>
            <span class="small muted">{a.outlet} · {a.when}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .elsewhere { margin-top: var(--space-5); }
  .elsewhere h2 { font-size: var(--fs-lg); }
  .ext { display: grid; gap: 0.2rem; }
  .ext a { font-size: var(--fs-md); text-decoration: none; color: var(--text); font-family: var(--serif); }
  .ext:hover a { color: var(--accent); }
</style>
