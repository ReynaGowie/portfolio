---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import SkillsPile from '../components/SkillsPile.astro';
import { profile, guessWho } from '../data/profile';
import { experience, certifications, committee } from '../data/cv';
import { stateOfState, iyc14, participation } from '../data/speaking';
import { url } from '../lib/url';

const dcDay = participation.find((p) => p.photo);
const photos = [
  ...(profile.headshot ? [{ src: profile.headshot.src, alt: profile.headshot.alt, pos: '50% 20%' }] : []),
  { src: stateOfState.photo.src, alt: stateOfState.photo.alt, pos: '42% 30%' },
  { src: iyc14.photo.src, alt: iyc14.photo.alt, pos: '50% 30%' },
  ...(dcDay?.photo ? [{ src: dcDay.photo.src, alt: dcDay.photo.alt, pos: '50% 15%' }] : []),
];
const education = [
  { title: profile.school, detail: `${profile.major} · expected ${profile.expectedGraduation}` },
  { title: profile.scholar, detail: 'Penn State Millennium Scholars Program' },
  { title: 'Smeal College Business Fundamentals Certificate', detail: 'In progress' },
];
const leadership: { title: string; detail: string; bullets?: string[] }[] = [
  { title: `${committee.role}, ${committee.name}`, detail: `${committee.org} · ${committee.when}`, bullets: committee.bullets },
  {
    title: `Course Creator and Student Instructor, ${guessWho.code}`,
    detail: `${guessWho.title} · teaching ${guessWho.term}`,
    bullets: [
      `Developed an approved undergraduate philosophy course, scheduled to launch at Penn State University Park in ${guessWho.term}.`,
      'Collaborated with faculty and teaching specialists on an inclusive syllabus, accessible assignments, and a supportive classroom environment.',
    ],
  },
  { title: 'President, Students Teaching Students', detail: 'Penn State · 2026–present' },
];
const certShown = certifications.slice(0, 3);
const certMore = certifications.slice(3);
---
<BaseLayout title="About" description={`About ${profile.name}: Enterprise Technology Integration at Penn State, AI Engineer Co-Op at IBM, and president of Students Teaching Students.`}>
  <div class="narrow">
    <div class="hero-panel about-hero">
      <PhotoStrip photos={photos} />
      <h1>Hi, I’m Reyna</h1>
    </div>

    <div class="card intro">
      <div class="prose">
        <p>Plenty of systems work exactly as designed and still fail the people who depend on them. I want to build ones that don’t.</p>
        <p>At Penn State, I study Enterprise Technology Integration: how organizations choose, build, and run technology systems. I’m a Millennium Scholar and am also earning the Smeal College Business Fundamentals Certificate. Alongside school, I work as an AI Engineer Co-Op at IBM, applying AI to business problems.</p>
        <p>Some of my building happens outside software. As president of Students Teaching Students, I help undergraduates turn their ideas into real, for-credit courses. I’ve also designed my own: <em>{guessWho.title}</em>, a philosophy seminar launching in {guessWho.term}.</p>
        <p>Through speaking and youth policy participation, I explore who shapes technology and what education should prepare us to do.</p>
        <p>Across these interests, I want to build systems people can question, influence, and use on their own terms.</p>
      </div>
    </div>

    <section class="block"><SkillsPile /></section>

    <section class="block" aria-labelledby="exp-h">
      <h2 class="label" id="exp-h">Experience</h2>
      <div class="panel">
        {experience.map((e) => (
          <div class="card row"><p class="t">{e.role}</p><p class="d">{e.org} · {e.when}</p><ul class="b">{e.bullets.map((b) => <li>{b}</li>)}</ul></div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="lead-h">
      <h2 class="label" id="lead-h">Leadership and service</h2>
      <div class="panel">
        {leadership.map((l) => (
          <div class="card row"><p class="t">{l.title}</p><p class="d">{l.detail}</p>{l.bullets && <ul class="b">{l.bullets.map((b) => <li>{b}</li>)}</ul>}</div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="edu-h">
      <h2 class="label" id="edu-h">Education</h2>
      <div class="panel">
        {education.map((e) => <div class="card row"><p class="t">{e.title}</p><p class="d">{e.detail}</p></div>)}
      </div>
    </section>

    <section class="block" aria-labelledby="cert-h">
      <h2 class="label" id="cert-h">Certifications</h2>
      <div class="panel">
        {certShown.map((c) => <div class="card row"><p class="t">{c.name}</p><p class="d">{c.issuer} · {c.when}</p></div>)}
        {certMore.length > 0 && (
          <details class="more">
            <summary><span class="more-label">Show {certMore.length} more</span><span class="less">Show less</span></summary>
            <div>{certMore.map((c) => <div class="card row"><p class="t">{c.name}</p><p class="d">{c.issuer} · {c.when}</p></div>)}</div>
          </details>
        )}
      </div>
    </section>

    <div class="actions next">
      <a class="btn btn-primary" href={url('/projects/')}>See my projects</a>
      <a class="btn btn-secondary" href={url('/speaking/')}>Speaking</a>
    </div>
  </div>
</BaseLayout>
<style>
  .about-hero { text-align: center; padding-bottom: var(--space-3); }
  .about-hero h1 { margin: 0; }
  .intro .prose { font-size: var(--fs-base); }
  .block { margin-top: var(--space-4); }
  .row .t { font-weight: 500; margin: 0; }
  .row .d { font-size: var(--fs-sm); color: var(--muted); margin: 0.15rem 0 0; }
  .row .b { font-size: var(--fs-sm); margin: 0.6rem 0 0; padding-left: 1.1rem; }
  .row .b li + li { margin-top: 0.3rem; }
  .next { justify-content: center; margin-top: var(--space-5); }
</style>
