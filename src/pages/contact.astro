---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="Contact" description="How to reach Reyna Simone Gowie for professional conversations.">
  <div class="narrow hero-panel contact">
    <h1>Let’s talk</h1>
    <p class="lede">I’m open to conversations about AI engineering, AI product, technology strategy, speaking, and research.</p>
    <p>The best way to reach me is a message on LinkedIn.</p>
    <div class="actions">
      <a class="btn btn-primary" href={profile.linkedin} rel="noopener">Connect on LinkedIn</a>
      {profile.email && <a class="btn btn-secondary" href={`mailto:${profile.email}`}>Email me</a>}
    </div>
  </div>
</BaseLayout>
<style>
  .contact { text-align: center; padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem); }
  .contact .lede { margin-inline: auto; }
  .contact .actions { justify-content: center; }
</style>
