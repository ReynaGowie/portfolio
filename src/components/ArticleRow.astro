---
import type { CollectionEntry } from 'astro:content';
import { url, readingMinutes } from '../lib/url';
interface Props { post: CollectionEntry<'blog'>; headingLevel?: 'h2' | 'h3'; showImage?: boolean }
const { post, headingLevel = 'h3', showImage = false } = Astro.props;
const H = headingLevel;
const href = url(`/blog/${post.id}/`);
const mins = readingMinutes(post.body);
const showStatus = import.meta.env.DEV && post.data.status !== 'final';
---
<article class:list={['card', 'card-link', 'row', { 'with-image': showImage }]}>
  {showImage && (
    <div class="thumb"><img src={url(post.data.image.src)} alt="" loading="lazy" width="1200" height="675" /></div>
  )}
  <div class="text">
    <p class="meta">{post.data.topic} · {mins} min read{showStatus && <> <span class="status">{post.data.status}</span></>}</p>
    <H class="title"><a class="stretch" href={href}>{post.data.title}</a></H>
    <p class="excerpt">{post.data.description}</p>
  </div>
</article>
<style>
  .row { display: grid; gap: var(--space-2); }
  @media (min-width: 40rem) { .with-image { grid-template-columns: 13rem 1fr; align-items: center; } }
  .thumb img { border-radius: var(--r-sm); aspect-ratio: 16 / 9; object-fit: cover; width: 100%; background: #fff; }
  .meta { font-size: var(--fs-sm); color: var(--muted); margin-bottom: 0.35rem; }
  .title { font-size: var(--fs-md); margin-bottom: 0.35rem; }
  .title a { color: var(--text); text-decoration: none; }
  .row:hover .title a { color: var(--accent); }
  .excerpt { color: var(--muted); margin: 0; max-width: 40rem; }
</style>
