---
interface Props { status: string; title: string; href: string; kicker: string }
const { status, title, href, kicker } = Astro.props;
---
<article class="work">
  <p class="kicker">{kicker} <span class="status">{status}</span></p>
  <h3><a href={href}>{title}</a></h3>
  <slot />
</article>
<style>
  .work { border-top: 2px solid var(--accent); padding-top: var(--space-2); }
  .kicker { font-size: var(--step--1); color: var(--muted); display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 0.5rem; }
  h3 { font-size: var(--step-2); }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .work :global(p) { color: var(--muted); }
</style>
