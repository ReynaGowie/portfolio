---
import type { CollectionEntry } from 'astro:content';
import { url, readingMinutes } from '../lib/url';
interface Props { post: CollectionEntry<'blog'>; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const href = url(`/blog/${post.id}/`);
const mins = readingMinutes(post.body);
const showStatus = import.meta.env.DEV && post.data.status !== 'final';
---
<article class="card card-surface">
  <p class="top"><span>{post.data.topic}</span>{showStatus && <span class="status">{post.data.status}</span>}</p>
  <div class="img-wrap"><img src={url(post.data.image.src)} alt="" loading="lazy" width="1200" height="675" /></div>
  <H class="title"><a href={href}>{post.data.title}</a></H>
  <p class="excerpt">{post.data.description}</p>
  <p class="meta">{post.data.author} · {mins} min read</p>
</article>
<style>
  .card { padding: 0.9rem; display: flex; flex-direction: column; position: relative; transition: transform 180ms ease, box-shadow 180ms ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: var(--step--1); color: var(--muted); margin: 0.15rem 0.35rem 0.75rem; }
  .img-wrap { border-radius: 14px; overflow: hidden; background: var(--surface-2); }
  .img-wrap img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .title { font-family: var(--sans); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.01em; line-height: 1.3; margin: 1rem 0.35rem 0.5rem; }
  .title a { color: var(--text); text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .title a:focus-visible { outline: none; }
  .card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .excerpt { color: var(--muted); margin: 0 0.35rem 1rem; font-size: 0.98rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { font-size: var(--step--1); color: var(--muted); margin: auto 0.35rem 0.25rem; opacity: 0.85; }
</style>
