---
import { nav, profile } from '../data/profile';
import { url } from '../lib/url';
---
<footer class="site-footer">
  <div class="wrap foot">
    <div>
      <p class="name">{profile.name}</p>
      <p class="small">Views on this site are my own and don’t represent IBM or Penn State.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        <li><a href={profile.linkedin} rel="noopener">LinkedIn</a></li>
      </ul>
    </nav>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border); padding-block: var(--space-4); font-size: var(--step--1); color: var(--muted); }
  .foot { display: flex; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .name { font-family: var(--serif); font-size: 1.1rem; color: var(--text); margin-bottom: 0.25rem; }
  .small { margin: 0; max-width: 32rem; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  a { color: var(--muted); }
  a:hover { color: var(--accent); }
</style>
