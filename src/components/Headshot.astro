---
import { profile } from '../data/profile';
import { url } from '../lib/url';
interface Props { size?: 'lg' | 'md' }
const { size = 'lg' } = Astro.props;
const shot = profile.headshot;
---
{shot ? (
  <img class={`headshot ${size}`} src={url(shot.src)} alt={shot.alt} width="800" height="1000" />
) : (
  <div class={`headshot placeholder ${size}`} role="img" aria-label="Headshot placeholder for development; replace with an approved photo">
    <span class="initials" aria-hidden="true">RG</span>
    {import.meta.env.DEV && <span class="ph-label">Headshot placeholder</span>}
  </div>
)}
<style>
  .headshot { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r); }
  .lg { max-width: 22rem; }
  .md { max-width: 16rem; }
  .placeholder { display: grid; place-items: center; align-content: center; gap: 0.5rem; background: var(--accent-soft); }
  .initials { font-family: var(--serif); font-size: 4rem; color: var(--accent); }
  .ph-label { font-size: var(--fs-sm); color: var(--accent); }
</style>
